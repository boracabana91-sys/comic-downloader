{
  "name": "cattyfied",
  "productName": "Cattyfied",
  "version": "0.2.0",
  "description": "Cattyfied: punch-line synced short videos, made easy.",
  "author": "Cattyfied",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "dist:mac": "electron-vite build && electron-builder --mac --universal --publish never",
    "prepare:binaries": "node build/prepare-binaries.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {},
  "build": {
    "appId": "com.cattyfied.app",
    "productName": "Cattyfied",
    "copyright": "Cattyfied",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      }
    ],
    "afterSign": "build/adhoc-sign.cjs",
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.video",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "x64ArchFiles": "Contents/Resources/bin/*"
    },
    "dmg": {
      "title": "Cattyfied ${version}",
      "artifactName": "Cattyfied-${version}.dmg",
      "window": {
        "width": 660,
        "height": 440
      },
      "contents": [
        {
          "x": 130,
          "y": 150,
          "type": "file"
        },
        {
          "x": 330,
          "y": 150,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 530,
          "y": 150,
          "type": "file",
          "path": "installer/Double-click me first.command"
        },
        {
          "x": 230,
          "y": 320,
          "type": "file",
          "path": "installer/Start Here.html"
        },
        {
          "x": 430,
          "y": 320,
          "type": "file",
          "path": "installer/README.txt"
        }
      ]
    }
  }
}
